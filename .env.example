# Port for the web app (the worker has no port).
PORT=4105
# Model for the assistant. Leave empty to use the Claude Code default.
AGENT_MODEL=claude-sonnet-5-5
# 1 = play recorded runs from fixtures/ (no login or key needed).
DEMO_REPLAY=0
# Optional. Without it the app uses the local Claude Code login.
ANTHROPIC_API_KEY=
# SQLite file shared by the web app and the worker.
GREENLIGHT_DB=data/greenlight.db
# Multiplies simulated render time (1 = 1-3 s per job).
RENDER_LATENCY_SCALE=1
